{
  "name": "vidashboard",
  "version": "1.0.0",
  "description": "ViDashboard - Product Video Discovery Dashboard",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "dev:all": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=backend",
    "test:all": "npm run test --workspaces",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:rollback": "npm run db:rollback --workspace=backend",
    "db:reset-seen": "npm run db:reset-seen --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
