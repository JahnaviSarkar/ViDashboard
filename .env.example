# ==============================================================================
# ViDashboard - Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Operational Mode
# 'live' = real API collectors and real AI vision
# 'mock' = mock provider returns deterministic test data with isMock: true
MODE=live

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vidashboard
POSTGRES_PORT=5432

# Job Queue (pg-boss)
PG_BOSS_SCHEMA=pgboss

# Storage & Uploads
UPLOAD_DIR=./uploads

# Vision / AI Provider
# Options: 'gemini' | 'mock'
VISION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Social Media Collectors (Phase 3)
# Meta Graph API Token for Instagram Reels hashtag media
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_token_here
# Meta Ad Library Access Token (ads_archive)
META_ACCESS_TOKEN=your_meta_ad_library_token_here
# Optional TikTok access token
TIKTOK_ACCESS_TOKEN=
# Optional Apify actor token (compliant public collector fallback)
APIFY_API_TOKEN=

# Scoring & Deduplication Configuration (Phase 4)
# Minimum match score (0-100) for a video to be marked above threshold
MIN_MATCH_THRESHOLD=60
# Weights for hybrid scoring (must sum to 1.0)
EMBEDDING_WEIGHT=0.4
RUBRIC_WEIGHT=0.6
# Near-duplicate perceptual hash (dHash) max Hamming distance threshold (default 10)
DHASH_THRESHOLD=10
