# ==============================================================================
# ViDashboard - Environment Configuration
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Operational Mode
# 'live' = real API collectors and real AI vision
# 'mock' = mock provider returns deterministic test data with isMock: true
MODE=live

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vidashboard
POSTGRES_PORT=5432

# Job Queue (pg-boss)
PG_BOSS_SCHEMA=pgboss

# Storage & Uploads
UPLOAD_DIR=./uploads

# Vision / AI Provider
# Options: 'gemini' | 'mock'
VISION_PROVIDER=gemini
# Gemini model name (default: "gemini-2.5-flash"; recommended working model: "gemini-3.5-flash-lite")
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Social Media Collectors (Phase 3 & 3b)
# Official Meta Graph API Tokens (used if present)
INSTAGRAM_ACCESS_TOKEN=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Apify Provider Configuration (used when official tokens are absent)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-hashtag-scraper
APIFY_META_ADS_ACTOR=curious_coder/facebook-ads-library-scraper
APIFY_MAX_ITEMS_PER_RUN=40
APIFY_MAX_RUNS_PER_SEARCH=3
STORAGE_DIR=./storage

# Scoring & Deduplication Configuration (Phase 4)
# Minimum match score (0-100) for a video to be marked above threshold
MIN_MATCH_THRESHOLD=60
# Weights for hybrid scoring (must sum to 1.0)
EMBEDDING_WEIGHT=0.4
RUBRIC_WEIGHT=0.6
# Near-duplicate perceptual hash (dHash) max Hamming distance threshold (default 10)
DHASH_THRESHOLD=10
